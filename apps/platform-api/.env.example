PORT=3001
DATABASE_URL=postgresql://cloudit:changeme@postgres:5432/platform?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
JWT_SECRET=your-jwt-secret-here
# Comma-separated whitelist. Use * to allow all origins (not recommended in production).
CORS_ORIGIN=http://localhost:3000,https://app.cloudit.lk
INTERNAL_API_TOKEN=your-internal-api-token-here

# Product API URLs used by the onboarding service to provision tenants.
# Use internal Docker service names in production/container networks.
TOUCHORBIT_API_URL=http://touchorbit-api:3006/api
ORBITONE_API_URL=http://orbitone-api:3004/api
HOSPITALITY_API_URL=http://hospitality-api:3002/api

# Product frontend URLs used in invite and welcome emails.
TOUCHORBIT_WEB_URL=https://touchorbit.cloudit.lk
ORBITONE_WEB_URL=https://orbitone.cloudit.lk
HOSPITALITY_WEB_URL=https://hospitality.cloudit.lk

# Email delivery webhook (optional). If not set, emails are logged only.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_API_KEY=

# Rate limiting (default: 100 requests per minute)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# n8n Webhook Integration
N8N_WEBHOOK_URL=https://n8n.cloudit.lk/webhook/cloudit-events
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret-here

# Super admin emails (comma-separated) allowed to manage organization modules
SUPER_ADMIN_EMAILS=admin@cloudit.lk

# AI Provider (openai | anthropic | local)
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key-here

# WhatsApp Business API Placeholders
WHATSAPP_API_KEY=your-whatsapp-api-key-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token-here


# Operations database (read-only OperationsModule). Never put a dollar
# character in any of these values — Docker Compose env_file interpolation
# corrupts them.
# OPERATIONS_DB_HOST=postgres
# OPERATIONS_DB_PORT=5432
# OPERATIONS_DB_NAME=operations
# OPERATIONS_DB_USER=operations_owner
# OPERATIONS_DB_PASSWORD=
# Fallback shared role password name used on the server (see infra/postgres/.env):
# OPERATIONS_DB_OWNER_PASSWORD=
# Token required on the x-operations-internal-token header for /api/operations/*:
# OPERATIONS_INTERNAL_API_TOKEN=
# Must match OPERATIONS_REPORT_PDF_RELAY_SECRET in operations-web and n8n.
# Used only to verify the signed, short-lived PDF relay claim.
# OPERATIONS_REPORT_PDF_RELAY_SECRET=

# Phase 10 guarded report commands (approve-and-send / reject / retry-send).
# OPERATIONS_REPORT_COMMAND_SECRET: HMAC-SHA256 secret used to sign the
# dispatch payload relayed to n8n. At least 32 characters, must be the same
# value in the n8n environment, dedicated to this flow (never reuse the PDF
# relay or ingest secrets), and must not contain a dollar character.
# OPERATIONS_REPORT_COMMAND_TOKEN: Header Auth value for the n8n
# 'CloudIT Report Command' credential, sent as x-cloudit-report-command-token.
# At least 32 characters, no dollar character.
# OPERATIONS_REPORT_COMMAND_URL: n8n webhook that receives the signed command
# (default http://n8n:5678/webhook/cloudit-report-command).
# OPERATIONS_REPORT_COMMAND_SECRET=
# OPERATIONS_REPORT_COMMAND_TOKEN=
# OPERATIONS_REPORT_COMMAND_URL=http://n8n:5678/webhook/cloudit-report-command
