# Copy to .env and replace every placeholder before starting the service.
OPERATIONS_OWNER_EMAIL=owner@example.com
OPERATIONS_PUBLIC_ORIGIN=https://operations.cloudit.lk
# Format: scrypt.<salt hex>.<64-byte derived key hex>
# (dot separators — '$' is mangled by some Docker Compose env_file versions)
OPERATIONS_OWNER_PASSWORD_HASH=scrypt.replace-with-random-salt.replace-with-derived-key
OPERATIONS_SESSION_SECRET=replace-with-at-least-32-random-characters
OPERATIONS_SESSION_TTL_SECONDS=28800
OPERATIONS_MFA_REQUIRED=false
# TOTP is deferred by owner decision for the initial rollout. It must be
# enabled (true, with OPERATIONS_OWNER_TOTP_SECRET) no later than before the
# Phase 10 report actions are exposed.
# Base32 TOTP secret. Never expose it to browser code or commit a real value.
# OPERATIONS_OWNER_TOTP_SECRET=replace-with-base32-secret
# Internal read-only operations API (server-side only — never exposed to the browser).
# OPERATIONS_API_BASE_URL=http://platform-api:3001
# OPERATIONS_INTERNAL_API_TOKEN=replace-with-the-internal-api-token
# Private Phase 9 PDF relay. The URL and both secrets are server-only.
# Prefer the private Docker-network endpoint in production:
# OPERATIONS_REPORT_PDF_RELAY_URL=http://n8n:5678/webhook/cloudit-report-pdf-relay
# OPERATIONS_REPORT_PDF_RELAY_TOKEN=replace-with-a-dedicated-header-auth-token
# OPERATIONS_REPORT_PDF_RELAY_SECRET=replace-with-at-least-32-random-characters
