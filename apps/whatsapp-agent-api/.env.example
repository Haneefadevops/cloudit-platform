# Server
PORT=3010
NODE_ENV=development
# Public URL used for webhooks (Chatwoot, Meta)
API_PUBLIC_URL=https://api.thereplyte.com

# Database
# 'postgres' is the Docker service name on the cloudit network.
# Deploy will replace these placeholder credentials with the real ones from infra/postgres/.env.
DATABASE_URL=postgresql://cloudit:changeme@postgres:5432/whatsapp_agent?schema=public

# Security
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Meta WhatsApp API
META_API_BASE_URL=https://graph.facebook.com/v18.0
META_VERIFY_TOKEN=your_meta_webhook_verify_token
META_WEBHOOK_SECRET=your_meta_webhook_app_secret
# Meta App → Settings → Basic → App Secret. Used to verify the
# x-hub-signature-256 header on incoming webhooks (HMAC-SHA256 of the raw body).
# MUST be set in production — without it, webhook signature verification is skipped.
META_APP_SECRET=your_meta_app_secret

# WhatsApp message templates (created + approved in Meta WhatsApp Manager, per WABA).
# Used when a business-initiated message falls outside the 24h customer window —
# Meta rejects free-form sends then (error 131047), so the sender falls back to
# these templates. Values are the template names; defaults match the names below.
TEMPLATE_BOOKING_REMINDER=booking_reminder
TEMPLATE_ORDER_UPDATE=order_update
TEMPLATE_BOOKING_CONFIRMED=booking_confirmed
TEMPLATE_GENERAL_FOLLOWUP=general_followup

# Kimi API
KIMI_API_KEY=your_kimi_api_key
KIMI_API_URL=https://api.moonshot.ai/v1/chat/completions
KIMI_MODEL=kimi-latest
# Vision model used to describe incoming WhatsApp images (must support image input)
KIMI_VISION_MODEL=kimi-latest

# Whisper transcription for incoming voice notes (OpenAI-compatible API)
# Falls back to EMBEDDING_API_KEY when WHISPER_API_KEY is not set.
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=your_openai_api_key
WHISPER_MODEL=whisper-1

# Embeddings (for knowledge base RAG)
# Defaults to the same provider as Kimi. OpenAI-compatible endpoint required.
EMBEDDING_API_URL=https://api.moonshot.ai/v1/embeddings
EMBEDDING_API_KEY=your_kimi_api_key
EMBEDDING_MODEL=moonshot-v3-embedding

# Chatwoot integration
CHATWOOT_PLATFORM_API_URL=http://chatwoot-rails:3000
CHATWOOT_PLATFORM_API_KEY=your_chatwoot_platform_api_key
# Account-scoped admin token and Chatwoot admin user id (must be a super admin)
CHATWOOT_ADMIN_API_KEY=your_chatwoot_admin_user_token
CHATWOOT_ADMIN_USER_ID=1
CHATWOOT_WEBHOOK_SECRET=your_webhook_secret_for_chatwoot_messages

# Chatwoot database (used to auto-confirm newly created users and skip SMTP verification,
# and to apply the TheReplyte installation branding below)
# These credentials must match infra/chatwoot/.env
CHATWOOT_DATABASE_URL=postgresql://cloudit:changeme@postgres:5432/chatwoot

# Chatwoot installation branding (applied automatically on API start; requires CHATWOOT_DATABASE_URL)
# Instance-wide: every client account sees this name in the Chatwoot UI.
# Restart chatwoot-rails once after the first apply — Chatwoot caches these configs.
CHATWOOT_BRAND_NAME=TheReplyte
CHATWOOT_BRAND_URL=https://thereplyte.com
# Optional: hosted logo URL for the Chatwoot UI (empty = Chatwoot default logo)
CHATWOOT_BRAND_LOGO_URL=

# Optional n8n webhook for urgent handoff alerts
N8N_WEBHOOK_URL=

# CORS
CORS_ORIGIN=http://localhost:3011,https://app.thereplyte.com

# AI usage cost estimation (USD per 1M tokens)
# Defaults to 0, which makes estimatedCostUsd always 0.
AI_INPUT_PRICE_PER_1M_TOKENS=0.5
AI_OUTPUT_PRICE_PER_1M_TOKENS=1.5

# Top-up requests (Phase 7.5)
# Bank account details shown to clients after they create a top-up request
# (they use the request reference code as the transfer narration).
TOPUP_BANK_DETAILS=
# Staff alert routing is managed in the dashboard (Settings → Alert
# notifications). STAFF_ALERT_WHATSAPP below is only a fallback used while
# the alert-contacts table is empty.
# Timezone used to evaluate scheduled contacts' on-duty windows.
ALERT_TIMEZONE=Asia/Colombo
# WhatsApp number that receives staff alerts for top-up requests
# (request created + slip uploaded). Empty = alerts disabled.
STAFF_ALERT_WHATSAPP=
