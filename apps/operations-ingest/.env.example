# Local development only — the production container does not read this file.
# It receives its environment from infra/postgres/.env and infra/redis/.env
# via infra/operations-ingest/docker-compose.yml.

PORT=3020
OPERATIONS_DB_HOST=localhost
OPERATIONS_DB_PORT=5432
OPERATIONS_DB_NAME=operations
OPERATIONS_DB_USER=operations_ingest
OPERATIONS_DB_PASSWORD=change-me

# Per-publisher HMAC secrets. The suffix is the upper-cased publisher key with
# non-alphanumeric runs mapped to underscores. Must match the value seeded in
# the operations database (infra/postgres/.env).
OPERATIONS_PUBLISHER_SECRET_CAVETTA_PRODUCTION_N8N=change-me
