# Public test hostname. The Cloudflare DNS record must point to this server.
N8N_TEST_HOST=n8n-test.cloudit.lk

# Generate each secret independently on the server with: openssl rand -hex 32
# Never reuse the production n8n encryption key.
N8N_TEST_ENCRYPTION_KEY=replace_with_a_unique_encryption_key
N8N_TEST_POSTGRES_PASSWORD=replace_with_a_unique_postgres_password
N8N_TEST_REDIS_PASSWORD=replace_with_a_unique_redis_password

# Match production workflow scheduling unless a different test timezone is needed.
GENERIC_TIMEZONE=Asia/Colombo

# Retain successful/error execution data for seven days, capped at 10,000 runs.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
