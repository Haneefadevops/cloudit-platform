# PostgreSQL
# Not exposed to the internet — internal only via cloudit network

POSTGRES_DB=cloudit
POSTGRES_USER=cloudit
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_PORT=5432

# CloudIT Operations Portal (Phase 3) — dedicated `operations` database roles.
# Real values live only in the server's gitignored infra/postgres/.env.
# Never commit real passwords; generate long random values (32+ characters,
# no `$` because some Docker Compose env_file versions interpolate `$`).
OPERATIONS_DB_OWNER_PASSWORD=change_this_to_a_long_random_password
OPERATIONS_DB_INGEST_PASSWORD=change_this_to_a_long_random_password

# CloudIT Operations Portal (Phase 4) — Cavetta production publisher secret.
# Stored only as a salted hash in the operations database and as this value in
# the n8n credential; identical copies are required in both places. The
# operations-ingest service reads the same variable name for HMAC verification.
OPERATIONS_PUBLISHER_SECRET_CAVETTA_PRODUCTION_N8N=change_this_to_a_long_random_secret
