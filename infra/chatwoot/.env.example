# Chatwoot server environment
# Copy to .env and fill in real values before deploying Messenger/Instagram support.

# Required for Messenger and Instagram OAuth/webhook verification.
# Get these from the Meta Developers app dashboard.
FB_APP_ID=your_meta_app_id
FB_APP_SECRET=your_meta_app_secret
FB_VERIFY_TOKEN=your_messenger_verify_token
IG_VERIFY_TOKEN=your_instagram_verify_token

# Standard Chatwoot variables (examples only — preserve existing values).
# FRONTEND_URL=https://inbox.thereplyte.com
# SECRET_KEY_BASE=...
# POSTGRES_PASSWORD=...
# REDIS_PASSWORD=...
