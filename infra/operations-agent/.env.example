# operations-agent protected env — SERVER ONLY. The real .env is git-ignored;
# this example is the template deploy.sh copies on first deploy. Never put real
# tokens in source control, and never paste real tokens into chat.
#
# Empty values resolve to the agent's safe disabled defaults: fully inert,
# nothing contacts Telegram, no AI calls, no remediation.

# --- Telegram (master switch; alerts and commands both stay dead while false) ---
TELEGRAM_COMMANDS_ENABLED=false
# TELEGRAM_BOT_TOKEN=<from @BotFather; required before enabling>
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=<random, e.g. openssl rand -hex 32; sent as secret_token>
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USER_IDS=<comma-separated numeric IDs; required before enabling>
TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_ALLOWED_CHAT_IDS=<comma-separated numeric IDs; alerts go to the FIRST>
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Hard-off programme switches (do not enable during the MVP soak) ---
AI_ENABLED=false
AUTO_REMEDIATION_ENABLED=false
REPAIR_MASTER_ENABLED=false

# --- Optional alert tuning (safe defaults shown) ---
# ALERTS_MAX_ALERTS_PER_HOUR=6
# ALERTS_OUTAGE_RETRY_MAX_ATTEMPTS=3
