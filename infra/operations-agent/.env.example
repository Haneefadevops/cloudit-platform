# operations-agent protected env — SERVER ONLY. The real .env is git-ignored;
# this example is the template deploy.sh copies on first deploy. Never put real
# tokens in source control, and never paste real tokens into chat.
#
# Empty values resolve to the agent's safe disabled defaults: fully inert,
# nothing contacts Telegram, no AI calls, no remediation.

# --- Telegram (master switch; alerts and commands both stay dead while false) ---
TELEGRAM_COMMANDS_ENABLED=false
# TELEGRAM_BOT_TOKEN=<from @BotFather; required before enabling>
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=<random, e.g. openssl rand -hex 32; sent as secret_token>
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USER_IDS=<comma-separated numeric IDs; required before enabling>
TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_ALLOWED_CHAT_IDS=<comma-separated numeric IDs; alerts go to the FIRST>
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_POLL_INTERVAL_MS=<chat phase: outbound getUpdates poll interval; default 10000, min 1000>
# TELEGRAM_POLL_INTERVAL_MS=10000

# --- Hard-off programme switches (do not enable during the MVP soak) ---
AI_ENABLED=false
AUTO_REMEDIATION_ENABLED=false
REPAIR_MASTER_ENABLED=false
# Per-runbook Tier A enable flag: read-only freshness re-check RB-READONLY-RECHECK-001.
# True only on the exact value 'true'; anything else stays off. Requires AUTO_REMEDIATION_ENABLED.
REMEDIATION_RB_READONLY_RECHECK_ENABLED=false

# --- AI provider (AI-brain phase; only read when AI_ENABLED=true, fail closed) ---
# OPENAI_API_KEY=<provider project key; required before enabling AI>
OPENAI_API_KEY=
# AI_PROVIDER_BASE_URL=<fixed provider base URL; default https://api.openai.com>
# AI_PROVIDER_BASE_URL=https://api.openai.com
# AI_FX_USD_TO_EUR=<USD→EUR FX converting the verified pricing snapshot; default 0.85>
# AI_FX_USD_TO_EUR=0.85

# --- Optional alert tuning (safe defaults shown) ---
# ALERTS_MAX_ALERTS_PER_HOUR=6
# ALERTS_OUTAGE_RETRY_MAX_ATTEMPTS=3

# --- Soak driver (read-only observation; password generated by deploy.sh) ---
# OPERATIONS_DB_HOST=postgres
# OPERATIONS_DB_PORT=5432
# OPERATIONS_DB_NAME=operations
# OPERATIONS_DB_USER=operations_reader
# OPERATIONS_DB_PASSWORD=<SELECT-only role; generated on the server, never in Git>
# OBSERVER_INTERVAL_MS=900000
# OBSERVER_DIGEST_HOUR_UTC=7
