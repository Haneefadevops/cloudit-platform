      "parameters": {
        "jsCode": "// Validate the signed, short-lived report command before any claim, lookup, or mutation.\n// OPERATIONS_REPORT_COMMAND_SECRET is a protected n8n environment value.\nconst crypto = require('crypto');\nconst body = $json.body ?? {};\nconst payload = body.payload ?? {};\nconst signature = String(body.signature ?? '');\nconst secret = String($env.OPERATIONS_REPORT_COMMAND_SECRET ?? '');\nconst version = String(payload.version ?? '');\nconst commandKey = String(payload.commandKey ?? '');\nconst commandType = String(payload.commandType ?? '');\nconst reportKey = String(payload.reportKey ?? '');\nconst clientKey = String(payload.clientKey ?? '');\nconst expectedRowVersion = Number(payload.expectedRowVersion);\nconst expectedState = String(payload.expectedState ?? '');\nconst nonce = String(payload.nonce ?? '');\nconst issuedAt = Number(payload.issuedAt);\nconst expiresAt = Number(payload.expiresAt);\nconst correlationId = String(payload.correlationId ?? '');\nconst recipientPolicyKey = String(payload.recipientPolicyKey ?? '');\nconst reasonDigest = String(payload.reasonDigest ?? '');\nconst now = Math.floor(Date.now() / 1000);\nconst reportKeyMatch = reportKey.match(/^cavetta\\.monthly_maintenance\\.(\\d{4}-\\d{2})$/);\nif (secret.length < 32 || version !== 'v1' || !/^[a-f0-9]{32}$/.test(commandKey) || !['APPROVE_AND_SEND', 'REJECT', 'RETRY_SEND'].includes(commandType) || !reportKeyMatch || clientKey !== 'cavetta' || !Number.isSafeInteger(expectedRowVersion) || expectedRowVersion <= 0 || !['DRAFT', 'SEND_FAILED'].includes(expectedState) || (commandType === 'RETRY_SEND' ? expectedState !== 'SEND_FAILED' : expectedState !== 'DRAFT') || !/^[a-f0-9]{64}$/.test(nonce) || !Number.isSafeInteger(issuedAt) || !Number.isSafeInteger(expiresAt) || issuedAt > now + 15 || issuedAt < now - 120 || expiresAt <= now || expiresAt > issuedAt + 180 || !/^[a-f0-9]{32}$/.test(correlationId) || (commandType === 'REJECT' ? recipientPolicyKey !== '-' : recipientPolicyKey !== 'cavetta-monthly-report') || (commandType === 'REJECT' ? !/^[a-f0-9]{64}$/.test(reasonDigest) : reasonDigest !== '-') || !/^[a-f0-9]{64}$/.test(signature)) throw new Error('Report command denied');\nconst canonical = [version, commandKey, commandType, reportKey, clientKey, String(expectedRowVersion), expectedState, nonce, issuedAt, expiresAt, correlationId, recipientPolicyKey, reasonDigest].join('\\n');\nconst expected = crypto.createHmac('sha256', secret).update(canonical).digest('hex');\nif (!crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'))) throw new Error('Report command denied');\nlet reason = null;\nif (commandType === 'REJECT') {\n  if (typeof body.reason !== 'string') throw new Error('Report command denied');\n  reason = body.reason.normalize('NFC').replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, '').trim().replace(/\\s+/g, ' ');\n  const digest = crypto.createHash('sha256').update(reason).digest('hex');\n  if (reason.length > 300 || digest !== reasonDigest) throw new Error('Report command denied');\n} else if (body.reason !== undefined && body.reason !== null) {\n  throw new Error('Report command denied');\n}\nreturn [{ json: { commandKey, commandType, reportKey, reportMonth: reportKeyMatch[1], reportType: 'MONTHLY_MAINTENANCE', clientKey, expectedRowVersion, expectedState, correlationId, nonce, reason } }];"
      },
