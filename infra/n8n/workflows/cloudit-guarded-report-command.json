      "parameters": {
        "jsCode": "// Guard the still-current authoritative row and compute the exact column\n// transition before the compare-and-set update. No fields are changed here.\nconst requested = $('Validate Signed Command').first().json;\nconst rows = $input.all().map((item) => item.json ?? {}).filter((row) => Object.keys(row).length > 0);\nlet outcome = null;\nif (rows.length !== 1) {\n  outcome = 'rejected_state';\n} else {\n  const row = rows[0];\n  const state = String(row.documentStatus ?? '').trim().toUpperCase();\n  const sentAt = String(row.sentAt ?? '').trim();\n  if (state !== String(requested.expectedState ?? '')) {\n    outcome = 'rejected_state';\n  } else if (requested.commandType === 'APPROVE_AND_SEND') {\n    const objectKey = String(row.pdfDriveFileId ?? '').trim();\n    const fileName = String(row.pdfFileName ?? '').trim();\n    if (!objectKey || !fileName || !/^[A-Za-z0-9 !/._-]+$/.test(objectKey) || objectKey.includes('..') || !objectKey.endsWith('/' + fileName) || sentAt) outcome = 'rejected_pdf_unavailable';\n  } else if (requested.commandType === 'RETRY_SEND') {\n    if (sentAt) outcome = 'rejected_state';\n  }\n}\nconst base = { commandKey: requested.commandKey, commandType: requested.commandType, reportMonth: requested.reportMonth, reportType: requested.reportType, expectedState: requested.expectedState };\nif (outcome) return [{ json: { guardPassed: false, outcome, columns: null, ...base } }];\nconst now = new Date().toISOString();\nlet columns;\nif (requested.commandType === 'APPROVE_AND_SEND') columns = { documentStatus: 'APPROVED', approvedAt: now, rejectedAt: null, rejectedReason: undefined };\nelse if (requested.commandType === 'REJECT') columns = { documentStatus: 'REJECTED', approvedAt: null, rejectedAt: now, rejectedReason: requested.reason };\nelse columns = { documentStatus: 'APPROVED', approvedAt: null, rejectedAt: null, rejectedReason: undefined };\nreturn [{ json: { guardPassed: true, outcome: null, columns, ...base } }];"
      },
